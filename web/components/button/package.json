{
  "name": "@k4k3ru/design-system-button",
  "version": "1.0.0",
  "description": "Utility for button component",
  "license": "MIT",
  "author": "k4k3ru",
  "type": "module",
  "files": ["dist"],
  "main": "./dist/script.js",
  "module": "./dist/script.js",
  "types": "./dist/script.d.ts",
  "style": "./dist/style.css",
  "exports": {
    ".": {
      "types": "./dist/script.d.ts",
      "import": "./dist/script.js",
      "default": "./dist/script.js"
    },
    "./style.css": "./dist/style.css"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json && node --input-type=module --eval \"import { copyFile } from 'node:fs/promises'; await copyFile('style.css', 'dist/style.css')\"",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/k4k3ru-hub/ui-ux-design-system.git",
    "directory": "web/components/button"
  }
}
