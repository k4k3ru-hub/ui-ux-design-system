{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "dist",

    "declaration": true,
    "declarationMap": false,
    "sourceMap": false,
    "removeComments": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,

    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "transform.ts",
    "vite.ts"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}
